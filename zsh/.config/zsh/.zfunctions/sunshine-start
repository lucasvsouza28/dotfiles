#!/bin/bash
# Creates (or reuses) a persistent virtual HEADLESS display and launches
# Sunshine.
#
# Sunshine (wlr-capture backend) reads output_name once at process startup and
# caches it — SIGHUP and HTTP API reloads do not refresh the cached value.
# So the HEADLESS monitor must exist AND its name must be written to
# sunshine.conf BEFORE we exec sunshine.
#
# The HEADLESS monitor is PERSISTENT across sunshine restarts: it is never
# removed here. Destroving it mid-session (e.g. a sunshine restart while a
# Moonlight client is connected) would force Hyprland to slam the migrated
# workspaces back onto the physical monitors — which are DPMS-off during
# streaming — stranding the local user. So:
#   * if a HEADLESS already exists, reuse it (and drop any extra ones),
#   * only if none exists, create a fresh one.
#
# Workspaces are left to Hyprland's default behavior on the two physical
# monitors — no workspace rules are installed here. The HEADLESS monitor is
# parked far off-screen between remote sessions so it never receives local
# workspaces, and the connect.sh migration is what pulls workspaces onto it
# while a client is streaming.

LOG="$HOME/.local/share/sunshine-headless.log"
CONF="$HOME/.config/sunshine/sunshine.conf"

# Detect Hyprland config provider
HYPR_CONF_PROVIDER=legacy
if [ "$(hyprctl dispatch 'hl.dsp.no_op()')" = "ok" ] ; then
    HYPR_CONF_PROVIDER=lua
fi

# --- Reuse an existing HEADLESS, or create one --------------------------------
# If several exist (accumulated across prior restarts), keep the one holding
# workspaces (the migrated sessions live there) and remove the extras.
HEADLESS=$(hyprctl monitors -j | python3 -c "
import sys,json
mon=json.load(sys.stdin)
ms=[m for m in mon if 'HEADLESS' in m['name']]
if not ms:
    print(''); raise SystemExit
ws=json.loads(__import__('subprocess').check_output(['hyprctl','workspaces','-j']))
def windows(name):
    return sum(w['windows'] for w in ws if w['monitor']==name)
keep=max(ms, key=lambda m: (windows(m['name']), -ms.index(m)))
print(keep['name'])")

if [ -z "$HEADLESS" ]; then
    hyprctl output create headless >> "$LOG" 2>&1
    sleep 0.8
    HEADLESS=$(hyprctl monitors -j | python3 -c \
        "import sys,json; ms=[m['name'] for m in json.load(sys.stdin) if 'HEADLESS' in m['name']]; print(ms[0] if ms else '')")
fi

if [ -z "$HEADLESS" ]; then
    echo "$(date -Iseconds) ERROR: failed to create headless monitor" >> "$LOG"
    exec sunshine
fi

echo "$(date -Iseconds) Headless in use: $HEADLESS" >> "$LOG"

# Remove any extra HEADLESS leftovers (keep only the chosen one).
hyprctl monitors -j | python3 -c \
    "import sys,json; [print(m['name']) for m in json.load(sys.stdin) if 'HEADLESS' in m['name'] and m['name'] != '$HEADLESS']" \
    | while read -r name; do
        [ -n "$name" ] && hyprctl output remove "$name" >> "$LOG" 2>&1 && sleep 0.3
    done

# 1280x720@60 (Nintendo Switch client), placed far off-screen so it can't be
# reached with the mouse.
if [ $HYPR_CONF_PROVIDER = "lua" ] ; then
    hyprctl eval "hl.monitor({output=\"$HEADLESS\", mode=\"1280x720@60.00\", position=\"9999x0\", scale=1})" >> "$LOG" 2>&1
else
    hyprctl keyword monitor "$HEADLESS,1280x720@60,9999x0,1" >> "$LOG" 2>&1
fi
sleep 0.3

# --- Write the headless name into sunshine.conf BEFORE launching sunshine ---
# Sunshine reads output_name once and caches it for the process lifetime.
# Replace the key if present, otherwise append it (a web-ui save can drop the
# key, leaving Sunshine capturing its default output instead of the headless).
if grep -q '^output_name' "$CONF"; then
    sed -i "s/^output_name *=.*/output_name = $HEADLESS/" "$CONF"
else
    printf '\noutput_name = %s\n' "$HEADLESS" >> "$CONF"
fi

exec sunshine